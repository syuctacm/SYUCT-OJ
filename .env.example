SERVER_PORT=8080
MONGO_URI=mongodb://syuct:syuct_dev_password@127.0.0.1:27017/syuct_oj?authSource=admin
MONGO_DATABASE=syuct_oj
CORS_ORIGINS=http://localhost:5173
JUDGE_USERNAME=judge
JUDGE_PASSWORD=judge_dev_password
JUDGE_FILE_ROOT=./data/judge-files
JUDGE_TASK_LEASE=2m
SESSION_TTL=24h
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW=1m
COOKIE_SECURE=0
# Optional SMTP fallback; database settings saved in /admin/settings take priority.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_SECURE=0
# Homepage countdown; COUNTDOWN_DATES is a JSON array.
COUNTDOWN_TITLE=倒计时
COUNTDOWN_MAX=5
COUNTDOWN_DATES=[{"name":"Example Event","date":"2026-12-31"}]
# Trusted onsite LAN IP auto-login; keep disabled unless explicitly needed.
ONSITE_IP_LOGIN=0
# WebAuthn relying party; production RPID is the hostname without scheme or port.
WEBAUTHN_RPID=localhost
WEBAUTHN_ORIGINS=http://localhost:5173,http://localhost:5174
WEBAUTHN_DISPLAY_NAME=SYUCT OJ
# Optional GitHub OAuth. Leave the client id/secret empty to disable it.
OAUTH_CALLBACK_BASE_URL=http://localhost:5173
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_GITHUB_CAN_REGISTER=1
