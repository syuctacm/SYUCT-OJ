# Copy to .env.prod (repo root) and fill in real values before starting the
# production-shaped stack. Never commit .env.prod.
MONGO_URI=mongodb://user:password@mongo.internal:27017/?authSource=admin
MONGO_DATABASE=syuct_oj
SERVER_PORT=8080
CORS_ORIGINS=https://oj.example.com
JUDGE_USERNAME=judge
JUDGE_PASSWORD=change-me
JUDGE_FILE_ROOT=/app/data/judge-files
JUDGE_TASK_LEASE=2m
SESSION_TTL=24h
# Login / password-change attempts per client IP and window.
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW=1m
# Enable when the site is served over HTTPS (required for Secure cookies).
COOKIE_SECURE=1
# WebAuthn must use the public HTTPS hostname and origin.
WEBAUTHN_RPID=oj.example.com
WEBAUTHN_ORIGINS=https://oj.example.com
WEBAUTHN_DISPLAY_NAME=SYUCT OJ
WEB_PORT=8080
